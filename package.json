{
    "name": "@corebyte/remote-wol",
    "version": "1.0.6",
    "type": "module",
    "main": "./dist/index.js",
    "bin": {
        "remote-wol": "./dist/index.js"
    },
    "devDependencies": {
        "@network-utils/arp-lookup": "^2.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-basic-auth": "^1.2.1",
        "fs-extra": "^11.2.0",
        "ping": "^0.4.4",
        "wol": "^1.0.7"
    },
    "scripts": {
        "run:node": "node .",
        "run:bun": "bun .",
        "watch:bun": "bun --watch ./src/index.js",
        "build": "rm -r ./dist/; bun build ./src/index.js --target=node --outdir=./dist --banner '#!/usr/bin/env node'",
        "test": "node ./dist/index.js",
        "publish": "bun run build; bun publish --access public"
    },
    "patchedDependencies": {
        "@network-utils/arp-lookup@2.1.0": "patches/@network-utils%2Farp-lookup@2.1.0.patch"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}